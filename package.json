    "b2b",
    "data-enrichment",
    "ai-agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bcharleson/leadmagic-agent-cli"
  },
  "homepage": "https://github.com/bcharleson/leadmagic-agent-cli#readme",
